DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_idesp
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# SMTP (opcional — fallback para console em dev)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lms-idesp.com
SMTP_TLS=true

# Password recovery
RESET_TOKEN_EXPIRE_MINUTES=60
BASE_URL=http://localhost:8000/api/v1

# Storage (S3)
# STORAGE_BACKEND=local    → salva em ./uploads/ (dev, sem infra)
# STORAGE_BACKEND=s3       → usa AWS S3 (produção)
STORAGE_BACKEND=local
S3_ENDPOINT=                        # vazio = endpoint padrão da região
S3_ACCESS_KEY=                      # AWS Access Key ID (IAM)
S3_SECRET_KEY=                      # AWS Secret Access Key (IAM)
S3_BUCKET=lms-conteudos
S3_REGION=sa-east-1
# Tamanho máximo de upload (500MB)
MAX_UPLOAD_SIZE=524288000

# Teams / Microsoft Graph (opcional — fallback para link manual)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_EMAIL=
