DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_idesp
SECRET_KEY=                                                                 # gere com: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# SMTP (opcional — fallback para console em dev)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lms-idesp.com
SMTP_TLS=true

# Password recovery
RESET_TOKEN_EXPIRE_MINUTES=60
BASE_URL=http://localhost:8000/api/v1
# Prefixo publico atras de proxy que remove o caminho (GKE: /treinamento-api)
ROOT_PATH=

# Storage (S3)
# STORAGE_BACKEND=local    → salva em ./uploads/ (dev, sem infra)
# STORAGE_BACKEND=s3       → usa AWS S3 (produção)
STORAGE_BACKEND=local
S3_ENDPOINT=                        # vazio = endpoint padrão da região
S3_ACCESS_KEY=                      # AWS Access Key ID (IAM)
S3_SECRET_KEY=                      # AWS Secret Access Key (IAM)
S3_BUCKET=lms-conteudos
S3_REGION=sa-east-1
# Tamanho máximo de upload (500MB)
MAX_UPLOAD_SIZE=524288000

# Testes (isolados do ambiente de dev; se vazio, usam o valor correspondente de produção)
TEST_DATABASE_URL=
TEST_STORAGE_BACKEND=local
TEST_S3_BUCKET=lms-conteudos-teste

# Teams / Microsoft Graph (opcional — fallback para link manual)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_EMAIL=

# Keycloak (staging — idesp-realm / treinamento-front)
KEYCLOAK_SERVER=https://keycloak-stg.idesp.sp.gov.br
KEYCLOAK_REALM=idesp-realm
KEYCLOAK_ISSUER=https://keycloak-stg.idesp.sp.gov.br/realms/idesp-realm
KEYCLOAK_CLIENT_ID=treinamento-front

# LGPD (issue #119)
# Versao do termo em vigor. Trocar aqui faz todo mundo precisar aceitar de novo,
# porque quem aceitou outra versao passa a contar como pendente.
VERSAO_TERMO_LGPD=provisoria-2026-10-22
# Recusa com 403 tudo que nao seja /usuarios/me, o aceite e o logout enquanto o
# aceite esta pendente. Deixar FALSE ate a tela de primeiro acesso existir no
# front: com o re-aceite, todos os usuarios de hoje comecam pendentes, e ligar
# antes disso tranca todo mundo fora da plataforma.
LGPD_BLOQUEIO_ATIVO=false
